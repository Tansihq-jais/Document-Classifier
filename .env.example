# Copy this file to .env and fill in your actual values
# cp .env.example .env

# Chroma Cloud credentials
# Get these from https://trychroma.com after creating a project
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_tenant_id_here
CHROMA_DATABASE=your_database_name_here

# Text extraction API
# Used during classification for PDF, image and DOCX text extraction
EXTRACTION_API_URL=https://staging-api.gipdataboard.io/api/extract_text_from_stream
EXTRACTION_API_TIMEOUT=30
